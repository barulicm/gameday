{% extends "../base.p2" %}

{% block title %}Unauthorized{% endblock %}

{% block content %}
<div class="box is-flex is-justify-content-center">
  <div>
    <h1>Unauthorized</h1>
    <br />
    <hr />
    {% if user.Identity %}
    <p>You do not have permission to access this page. The required permission is <code>{{ perm }}</code>.</p>
    {% else %}
    <p>Please log in to access this page.{% if perm.Module %} The required permission is <code>{{ perm }}</code>.{% endif %}</p>
    <br />
    <div class="is-flex is-justify-content-center">
      <a class="button" href="/login">Login</a>
    </div>
    {% endif %}
    <br />
    <div class="is-flex is-justify-content-center">
      <a class="button" href="/">Back to Home</a>
    </div>
  </div>
</div>
{% endblock %}
