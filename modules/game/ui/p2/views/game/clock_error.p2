{% extends "../../base.p2" %}

{% block title %}Clock Error{% endblock %}

{% block content %}
<div class="box is-flex is-justify-content-center">
  <div>
    <h1>Clock Error</h1>
    <br />
    <hr />
    <div class="notification is-danger">
      {{ error }}
    </div>
    <br />
    <div class="is-flex is-justify-content-center">
      <a class="button" href="{{ back }}">Back to Timekeeping</a>
    </div>
  </div>
</div>
{% endblock %}
