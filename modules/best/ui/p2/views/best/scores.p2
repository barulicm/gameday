{% extends "../../base.p2" %}

{% block title %}BEST Scores{% endblock %}

{% block head %}
    <link href="/static/css/scores.css" rel="stylesheet">
{% endblock %}

{% block content %}
  <div class="box is-flex is-justify-content-center">
    <div>
      <p>Click a score to edit it in place; press Enter to save. Leave the field empty to clear it.</p>
      <p class="is-size-7 has-text-grey">The Total here sums the judged categories only. The BEST Award also includes Robot Performance, which is derived from the seeding phase ranking and shown on the Awards page.</p>
      <br />
      <hr />

      {% for warning in low_scores %}
      <div class="notification is-warning is-light">
        <strong>All scores in {{ warning.Name }} are below 33% of the possible {{ warning.Max|floatformat:2 }} points.</strong>
        Every one of the {{ warning.Scored }} entered {{ warning.Name }} scores is under {{ warning.Threshold|floatformat:2 }}.
        Please confirm the category was judged on the intended scale before the results are announced.
      </div>
      {% endfor %}

      <table class="table">
        <tr>
          <th>Number</th>
          <th>Name</th>
          <th>Division</th>
          <th>Region</th>
          {% for c in score_types %}
          <th class="has-text-right" title="Max {{ c.Max }}">{{ c.Name }}</th>
          {% endfor %}
          <th class="has-text-right">Total</th>
        </tr>
        {% for row in scores %}
          <tr>
            <td>{{ row.Team.Number }}</td>
            <td>{{ row.Team.Name }}</td>
            <td>{{ row.Team.Division.Name }}</td>
            <td>{{ row.Team.Region.Name }}</td>
            {% for c in row.Cells %}
            <td class="has-text-right{% if c.Saved %} score-saved{% endif %}">
              <form method="post" action="{{ c.Action }}" class="score-form">
                <input
                  class="input is-small score-input"
                  type="number"
                  name="value"
                  step="0.01"
                  min="0"
                  max="{{ c.Max }}"
                  {% if c.Value %}value="{{ c.ValueFormatted }}"{% endif %}
                  placeholder="—"
                  onfocus="this.select()"
                >
              </form>
            </td>
            {% endfor %}
            <td class="has-text-right">{% if row.Total %}{{ row.Total|floatformat:2 }}{% else %}—{% endif %}</td>
          </tr>
          {% empty %}
          <tr>
            <td colspan="9">No teams found.</td>
          </tr>
        {% endfor %}
      </table>
    </div>
  </div>
{% endblock %}
